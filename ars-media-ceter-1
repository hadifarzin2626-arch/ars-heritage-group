/* =========================================================
   ARS MEDIA CENTER
   ARS SIGNATURE DESIGN SYSTEM
   SPECIAL SIGNATURE GOLD × ELECTRIC BLUE
   Complete standalone stylesheet — v1.0
========================================================= */

/* 01 — DESIGN TOKENS
========================================================= */

:root {
  color-scheme: dark;

  --ars-black: #020304;
  --ars-black-soft: #030507;
  --ars-black-raised: #06090d;

  --ars-navy-deep: #071019;
  --ars-navy: #0a111a;
  --ars-navy-mid: #101a26;
  --ars-navy-light: #162433;
  --ars-navy-raised: #1c2d3e;

  --ars-gold-deep: #4b3719;
  --ars-gold-shadow: #62491f;
  --ars-gold-bronze: #80602b;
  --ars-gold-antique: #a17a35;
  --ars-gold: #c19a49;
  --ars-gold-light: #d6b46b;
  --ars-gold-bright: #e8cb8b;
  --ars-gold-pale: #f2e2b7;
  --ars-gold-pearl: #f8eed2;

  --ars-blue-deep: #0874c4;
  --ars-blue: #159bff;
  --ars-blue-light: #39b5ff;
  --ars-blue-pale: #c8edff;

  --ars-white: #f3f5f7;
  --ars-white-soft: #e8edf1;
  --ars-text: #d7dde3;
  --ars-text-muted: #9aa5af;
  --ars-text-dim: #66717c;

  --ars-glass: rgba(4, 6, 9, 0.72);
  --ars-glass-light: rgba(15, 22, 30, 0.76);

  --ars-border: rgba(255, 255, 255, 0.075);
  --ars-border-gold: rgba(193, 154, 73, 0.26);
  --ars-border-blue: rgba(21, 155, 255, 0.25);

  --ars-font: Inter, "Segoe UI", Arial, sans-serif;
  --ars-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;

  --ars-ease: cubic-bezier(.22, .61, .36, 1);
  --ars-ease-premium: cubic-bezier(.16, 1, .3, 1);

  --ars-container: 1440px;
  --ars-gutter: clamp(20px, 5.5vw, 88px);

  --ars-radius-sm: 5px;
  --ars-radius-md: 10px;
  --ars-radius-lg: 16px;

  --ars-shadow:
    0 24px 80px rgba(0, 0, 0, .42);

  --ars-gold-gradient:
    linear-gradient(
      110deg,
      #80602b 0%,
      #c19a49 24%,
      #f2e2b7 47%,
      #d6b46b 66%,
      #a17a35 100%
    );

  --ars-blue-gradient:
    linear-gradient(
      110deg,
      #0874c4 0%,
      #159bff 55%,
      #c8edff 100%
    );
}


/* 02 — RESET & GLOBAL
========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
  background: var(--ars-black);
}

body {
  min-width: 320px;
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(21, 155, 255, .055),
      transparent 38%
    ),
    var(--ars-black);
  color: var(--ars-text);
  font-family: var(--ars-font);
  font-size: 15px;
  line-height: 1.7;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body,
button,
input,
textarea,
select {
  font-family: var(--ars-font);
}

img,
video,
svg {
  display: block;
  max-width: 100%;
}

img,
video {
  height: auto;
}

button,
input,
textarea,
select {
  color: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--ars-blue-light);
  outline-offset: 5px;
}

::selection {
  color: var(--ars-black);
  background: var(--ars-gold-light);
}

::-webkit-scrollbar {
  width: 9px;
}

::-webkit-scrollbar-track {
  background: #030507;
}

::-webkit-scrollbar-thumb {
  border: 2px solid #030507;
  border-radius: 20px;
  background: #34404a;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--ars-gold-antique);
}

#media-center,
main {
  position: relative;
  isolation: isolate;
}

.container {
  width: min(
    var(--ars-container),
    calc(100% - var(--ars-gutter) * 2)
  );
  margin-inline: auto;
}

section {
  position: relative;
}

h1,
h2,
h3,
h4,
p {
  margin-top: 0;
}

h1,
h2,
h3,
h4 {
  color: var(--ars-white);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: -.035em;
}

p {
  color: var(--ars-text-muted);
}

[hidden] {
  display: none !important;
}


/* 03 — SHARED UTILITIES
========================================================= */

.ars-glass {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--ars-border);
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .035),
      transparent 36%
    ),
    rgba(7, 11, 16, .78);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, .22),
    inset 0 1px 0 rgba(255, 255, 255, .025);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}

.media-kicker {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--ars-gold-light);
  font-family: var(--ars-mono);
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.media-kicker::before {
  width: 19px;
  height: 1px;
  flex: 0 0 19px;
  background: var(--ars-blue);
  content: "";
}

.section-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--ars-blue-light);
  font-family: var(--ars-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .2em;
  line-height: 1.6;
  text-transform: uppercase;
}

.section-label::before {
  width: 25px;
  height: 1px;
  background: var(--ars-gold);
  content: "";
}

.status-indicator,
.display-live-indicator {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ars-text-muted);
  font-family: var(--ars-mono);
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.status-indicator::before,
.display-live-indicator::before {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: var(--ars-blue);
  box-shadow: 0 0 12px rgba(21, 155, 255, .65);
  content: "";
}

.media-index,
.product-index,
.contact-number,
.division-number {
  color: var(--ars-gold);
  font-family: var(--ars-mono);
  font-size: 10px;
  letter-spacing: .12em;
  font-variant-numeric: tabular-nums;
}

.media-frame,
.product-image-frame {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at 50% 35%,
      rgba(21, 155, 255, .08),
      transparent 58%
    ),
    #05080c;
}

.media-frame::after,
.product-image-frame::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  border: 1px solid rgba(255, 255, 255, .045);
  pointer-events: none;
  content: "";
}

.media-frame img,
.media-frame video,
.product-image-frame img,
.product-image-frame video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition:
    transform 1.1s var(--ars-ease-premium),
    filter .8s var(--ars-ease);
}

.media-frame:hover img,
.media-frame:hover video,
.product-card:hover .product-image-frame img,
.product-card:hover .product-image-frame video,
.gallery-card:hover img {
  transform: scale(1.035);
}

.media-frame img,
.product-image-frame img {
  filter: saturate(.86) contrast(1.04);
}


/* 04 — SITE NAVIGATION
========================================================= */

.ars-site-header {
  position: absolute;
  z-index: 100;
  top: 0;
  right: 0;
  left: 0;
  padding: 20px var(--ars-gutter) 0;
}

.ars-nav-shell {
  position: relative;
  display: flex;
  width: min(1600px, 100%);
  min-height: 70px;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  margin-inline: auto;
  padding: 12px 22px;
  border: 1px solid rgba(255, 255, 255, .075);
  border-radius: var(--ars-radius-sm);
  background: rgba(3, 5, 8, .72);
  box-shadow: 0 12px 50px rgba(0, 0, 0, .2);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}

.ars-nav-brand {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 13px;
}

.ars-nav-brand img,
.ars-nav-brand svg {
  width: auto;
  max-width: 150px;
  max-height: 43px;
  object-fit: contain;
}

.ars-nav-brand a {
  display: inline-flex;
  align-items: center;
}

.ars-menu-toggle {
  display: none;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ars-border);
  border-radius: var(--ars-radius-sm);
  background: rgba(255, 255, 255, .025);
  color: var(--ars-gold-light);
  cursor: pointer;
  transition:
    border-color .25s ease,
    background .25s ease;
}

.ars-menu-toggle:hover {
  border-color: var(--ars-border-gold);
  background: rgba(193, 154, 73, .06);
}

.ars-menu-toggle span {
  display: block;
  width: 19px;
  height: 1px;
  margin: 4px 0;
  background: currentColor;
  transition:
    transform .25s ease,
    opacity .25s ease;
}

.ars-menu-toggle[aria-expanded="true"] span:first-child {
  transform: translateY(2.5px) rotate(45deg);
}

.ars-menu-toggle[aria-expanded="true"] span:last-child {
  transform: translateY(-2.5px) rotate(-45deg);
}

.ars-primary-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(15px, 2.1vw, 32px);
}

.ars-primary-nav a {
  position: relative;
  padding: 9px 0;
  color: #b9c1c8;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .045em;
  white-space: nowrap;
  transition: color .25s ease;
}

.ars-primary-nav a::after {
  position: absolute;
  right: 0;
  bottom: 2px;
  left: 0;
  height: 1px;
  background: var(--ars-gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .3s var(--ars-ease);
  content: "";
}

.ars-primary-nav a:hover,
.ars-primary-nav a:focus-visible {
  color: var(--ars-gold-pearl);
}

.ars-primary-nav a:hover::after,
.ars-primary-nav a:focus-visible::after {
  transform: scaleX(1);
}


/* 05 — HERO / ARS SIGNATURE EXPERIENCE
========================================================= */

.media-hero {
  position: relative;
  display: flex;
  min-height: 100svh;
  min-height: max(760px, 100svh);
  align-items: center;
  overflow: hidden;
  isolation: isolate;
  padding:
    150px
    var(--ars-gutter)
    110px;
  background:
    radial-gradient(
      ellipse at 70% 43%,
      rgba(193, 154, 73, .09),
      transparent 32%
    ),
    radial-gradient(
      ellipse at 20% 70%,
      rgba(8, 116, 196, .12),
      transparent 36%
    ),
    radial-gradient(
      ellipse at 50% 0%,
      rgba(22, 36, 51, .44),
      transparent 55%
    ),
    linear-gradient(
      130deg,
      #020304 0%,
      #05080c 49%,
      #071019 100%
    );
}

.media-hero::before {
  position: absolute;
  z-index: -1;
  inset: 0;
  background-image:
    linear-gradient(
      rgba(255, 255, 255, .025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, .025) 1px,
      transparent 1px
    );
  background-size: 90px 90px;
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, .55),
    transparent 92%
  );
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, .55),
    transparent 92%
  );
  pointer-events: none;
  content: "";
}

.media-hero::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(2, 3, 4, .9) 0%,
      rgba(2, 3, 4, .46) 53%,
      rgba(2, 3, 4, .72) 100%
    ),
    linear-gradient(
      0deg,
      #020304 0%,
      transparent 23%,
      transparent 78%,
      rgba(2, 3, 4, .55) 100%
    );
  pointer-events: none;
  content: "";
}

.media-background-glow {
  position: absolute;
  z-index: -1;
  top: 9%;
  right: -12%;
  width: min(900px, 76vw);
  aspect-ratio: 1;
  border: 1px solid rgba(193, 154, 73, .075);
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(193, 154, 73, .085) 0%,
      rgba(193, 154, 73, .025) 28%,
      rgba(21, 155, 255, .025) 46%,
      transparent 69%
    );
  box-shadow:
    0 0 100px rgba(193, 154, 73, .025),
    inset 0 0 90px rgba(21, 155, 255, .025);
  pointer-events: none;
  animation: ars-glow-breathe 12s ease-in-out infinite alternate;
}

.media-background-glow::before,
.media-background-glow::after {
  position: absolute;
  inset: 9%;
  border: 1px solid rgba(255, 255, 255, .035);
  border-radius: 50%;
  content: "";
}

.media-background-glow::after {
  inset: 20%;
  border-color: rgba(21, 155, 255, .075);
}

.hero-energy-lines {
  position: absolute;
  z-index: -1;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-energy-lines::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 8%;
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(21, 155, 255, .28) 30%,
    rgba(21, 155, 255, .04) 75%,
    transparent
  );
  content: "";
}

.hero-energy-lines::after {
  position: absolute;
  top: 0;
  right: 8%;
  bottom: 0;
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(193, 154, 73, .28) 24%,
    rgba(193, 154, 73, .04) 72%,
    transparent
  );
  content: "";
}

.media-hero-content {
  position: relative;
  z-index: 2;
  width: min(920px, 100%);
  margin-inline: auto;
  padding-block: 28px;
  text-align: left;
}

.media-logo-wrapper {
  display: flex;
  width: fit-content;
  max-width: 100%;
  align-items: center;
  margin-bottom: clamp(30px, 4.5vw, 62px);
}

.media-logo {
  display: block;
  width: auto;
  max-width: min(220px, 55vw);
  max-height: 90px;
  object-fit: contain;
  filter:
    drop-shadow(0 0 20px rgba(193, 154, 73, .08));
}

.media-overline {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
  color: var(--ars-blue-light);
  font-family: var(--ars-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .24em;
  line-height: 1.6;
  text-transform: uppercase;
}

.media-overline::before {
  width: 38px;
  height: 1px;
  background: var(--ars-gold);
  box-shadow: 0 0 12px rgba(193, 154, 73, .25);
  content: "";
}

.media-hero-title {
  max-width: 1000px;
  margin: 0 0 25px;
  color: var(--ars-gold-pearl);
  font-size: clamp(58px, 9vw, 148px);
  font-weight: 300;
  line-height: .88;
  letter-spacing: -.065em;
  text-transform: uppercase;
  overflow-wrap: anywhere;
  background: linear-gradient(
    115deg,
    #f8eed2 0%,
    #d6b46b 27%,
    #f2e2b7 49%,
    #a17a35 74%,
    #e8cb8b 100%
  );
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 9px 32px rgba(0, 0, 0, .28));
}

.media-hero-subtitle {
  max-width: 720px;
  margin-bottom: 22px;
  color: var(--ars-gold-light);
  font-size: clamp(17px, 2.1vw, 27px);
  font-weight: 300;
  line-height: 1.45;
  letter-spacing: -.025em;
}

.hero-description {
  max-width: 610px;
  margin-bottom: 35px;
  color: #aeb8c2;
  font-size: clamp(13px, 1.15vw, 15px);
  font-weight: 400;
  line-height: 1.95;
}

.media-buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 13px;
}

.btn-primary,
.btn-secondary {
  position: relative;
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  overflow: hidden;
  padding: 14px 25px;
  border: 1px solid transparent;
  border-radius: 2px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .09em;
  text-align: center;
  text-transform: uppercase;
  cursor: pointer;
  transition:
    color .3s ease,
    background .3s ease,
    border-color .3s ease,
    box-shadow .3s ease,
    transform .3s var(--ars-ease);
}

.btn-primary {
  border-color: var(--ars-gold);
  background: var(--ars-gold-gradient);
  color: #100d07;
  box-shadow: 0 7px 26px rgba(193, 154, 73, .1);
}

.btn-primary:hover {
  border-color: var(--ars-gold-pearl);
  box-shadow: 0 10px 36px rgba(193, 154, 73, .19);
  transform: translateY(-2px);
}

.btn-secondary {
  border-color: rgba(255, 255, 255, .18);
  background: rgba(255, 255, 255, .025);
  color: var(--ars-white-soft);
}

.btn-secondary:hover {
  border-color: var(--ars-blue);
  background: rgba(21, 155, 255, .07);
  color: var(--ars-blue-pale);
  transform: translateY(-2px);
}

.hero-scroll-indicator {
  position: absolute;
  z-index: 3;
  right: var(--ars-gutter);
  bottom: 36px;
  display: flex;
  align-items: center;
  gap: 14px;
  color: var(--ars-text-dim);
  font-family: var(--ars-mono);
  font-size: 9px;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.hero-scroll-indicator::before {
  width: 42px;
  height: 1px;
  background: linear-gradient(
    90deg,
    var(--ars-blue),
    transparent
  );
  content: "";
}

[data-hero-reveal] {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: no-preference) {
  [data-hero-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity .85s var(--ars-ease-premium),
      transform .85s var(--ars-ease-premium);
  }

  [data-hero-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-hero-reveal]:nth-child(2) {
    transition-delay: .08s;
  }

  [data-hero-reveal]:nth-child(3) {
    transition-delay: .16s;
  }

  [data-hero-reveal]:nth-child(4) {
    transition-delay: .24s;
  }

  [data-hero-reveal]:nth-child(5) {
    transition-delay: .32s;
  }
}


/* 06 — SECTION HEADERS
========================================================= */

.section-header {
  position: relative;
  margin-bottom: clamp(35px, 5vw, 68px);
}

.section-header .section-label {
  margin-bottom: 20px;
}

.spotlight-heading,
.subsection-heading {
  margin: 0;
  color: var(--ars-white);
  font-size: clamp(34px, 5vw, 68px);
  font-weight: 300;
  line-height: 1.02;
  letter-spacing: -.055em;
}

.spotlight-heading em,
.subsection-heading em {
  color: var(--ars-gold-light);
  font-style: normal;
}

.section-header > p {
  max-width: 650px;
  margin: 22px 0 0;
  color: var(--ars-text-muted);
  font-size: 14px;
  line-height: 1.9;
}


/* 07 — MEDIA SPOTLIGHT
========================================================= */

.media-spotlight {
  position: relative;
  padding: clamp(90px, 11vw, 155px) 0;
  background:
    radial-gradient(
      ellipse at 10% 20%,
      rgba(8, 116, 196, .055),
      transparent 36%
    ),
    linear-gradient(
      180deg,
      #020304 0%,
      #05080c 50%,
      #030507 100%
    );
}

.media-spotlight::before {
  position: absolute;
  top: 0;
  right: var(--ars-gutter);
  left: var(--ars-gutter);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(193, 154, 73, .28),
    rgba(21, 155, 255, .2),
    transparent
  );
  content: "";
}

.spotlight-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(300px, .85fr);
  align-items: stretch;
  gap: 22px;
}

.spotlight-video-card,
.spotlight-display-card {
  min-width: 0;
  border-radius: var(--ars-radius-sm);
}

.spotlight-video-card {
  padding: clamp(20px, 3vw, 36px);
}

.spotlight-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.spotlight-card-heading h3 {
  margin: 8px 0 0;
  font-size: clamp(20px, 2.4vw, 31px);
  font-weight: 300;
}

.spotlight-video-frame {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  border-radius: 3px;
  background: #020304;
}

.spotlight-video-frame::before {
  position: absolute;
  z-index: 2;
  inset: 0;
  border: 1px solid rgba(193, 154, 73, .12);
  pointer-events: none;
  content: "";
}

.spotlight-video-frame::after {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  height: 32%;
  background: linear-gradient(
    to top,
    rgba(2, 3, 4, .38),
    transparent
  );
  pointer-events: none;
  content: "";
}

.spotlight-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #020304;
}

.spotlight-video-footer,
.advertising-display-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding-top: 19px;
}

.spotlight-video-footer p,
.advertising-display-footer p {
  margin: 0;
  color: var(--ars-text-muted);
  font-size: 11px;
}

.spotlight-display-card {
  display: flex;
  flex-direction: column;
  padding: clamp(20px, 2.6vw, 32px);
}

.display-live-indicator {
  color: var(--ars-gold-light);
}

.advertising-rotator {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 320px;
  flex-direction: column;
}

.advertising-slides {
  position: relative;
  display: grid;
  flex: 1;
  min-height: 280px;
  overflow: hidden;
  background: #030507;
}

.advertising-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition:
    opacity .7s var(--ars-ease),
    visibility .7s;
}

.advertising-slide.is-active,
.advertising-slide.active,
.advertising-slide[aria-hidden="false"] {
  z-index: 1;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.advertising-slide img,
.advertising-slide video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.advertising-slide::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    0deg,
    rgba(2, 3, 4, .5),
    transparent 55%
  );
  pointer-events: none;
  content: "";
}

.advertising-control {
  display: inline-flex;
  width: 37px;
  height: 37px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--ars-border);
  border-radius: 50%;
  background: rgba(255, 255, 255, .025);
  color: var(--ars-gold-light);
  cursor: pointer;
  transition:
    border-color .25s ease,
    background .25s ease,
    color .25s ease;
}

.advertising-control:hover {
  border-color: var(--ars-blue);
  background: rgba(21, 155, 255, .08);
  color: var(--ars-blue-pale);
}

.advertising-counter {
  color: var(--ars-text-muted);
  font-family: var(--ars-mono);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.advertising-progress-track {
  position: relative;
  height: 2px;
  margin-top: 20px;
  overflow: hidden;
  background: rgba(255, 255, 255, .08);
}

.advertising-progress {
  display: block;
  width: 0;
  height: 100%;
  background: var(--ars-gold-gradient);
  transition: width .3s linear;
}

.advertising-pause {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  background: transparent;
  color: var(--ars-text-muted);
  font-family: var(--ars-mono);
  font-size: 9px;
  letter-spacing: .08em;
  cursor: pointer;
  transition: color .25s ease;
}

.advertising-pause:hover {
  color: var(--ars-gold-light);
}

.advertising-film-library {
  margin-top: clamp(70px, 9vw, 115px);
}

.advertising-film-library .subsection-heading {
  margin-bottom: 30px;
  font-size: clamp(27px, 3.8vw, 45px);
}

.film-library-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.film-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--ars-border);
  background: rgba(255, 255, 255, .015);
  transition:
    border-color .35s ease,
    background .35s ease,
    transform .35s var(--ars-ease);
}

.film-card:hover {
  border-color: var(--ars-border-gold);
  background: rgba(193, 154, 73, .025);
  transform: translateY(-4px);
}

.film-card img,
.film-card video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: #020304;
  transition: transform .7s var(--ars-ease-premium);
}

.film-card:hover img,
.film-card:hover video {
  transform: scale(1.035);
}

.film-card-content {
  padding: 21px;
}

.film-card-content h3 {
  margin-bottom: 9px;
  font-size: 19px;
  font-weight: 300;
}

.film-card-content p {
  margin-bottom: 0;
  font-size: 12px;
  line-height: 1.85;
}


/* 08 — ARS DIVISIONS
========================================================= */

.ars-divisions {
  position: relative;
  overflow: hidden;
  background: #030507;
}

.ars-divisions::before {
  position: absolute;
  top: 0;
  right: var(--ars-gutter);
  left: var(--ars-gutter);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, .09),
    transparent
  );
  content: "";
}

.media-division {
  position: relative;
  padding: clamp(90px, 11vw, 155px) 0;
  overflow: hidden;
  border-bottom: 1px solid rgba(255, 255, 255, .045);
  background:
    radial-gradient(
      ellipse at 92% 16%,
      rgba(21, 155, 255, .045),
      transparent 36%
    ),
    #030507;
}

.media-division:nth-child(even) {
  background:
    radial-gradient(
      ellipse at 8% 28%,
      rgba(193, 154, 73, .04),
      transparent 34%
    ),
    #05080c;
}

.media-division::before {
  position: absolute;
  top: 0;
  left: var(--ars-gutter);
  width: clamp(45px, 8vw, 120px);
  height: 1px;
  background: var(--ars-gold);
  opacity: .45;
  content: "";
}

.division-brain {
  --division-accent: var(--ars-blue-light);
}

.division-design {
  --division-accent: var(--ars-gold-light);
}

.division-signature {
  --division-accent: var(--ars-gold-bright);
}

.division-company {
  --division-accent: var(--ars-blue-light);
}

.division-rez-zhr {
  --division-accent: var(--ars-gold);
}

.division-general {
  --division-accent: var(--ars-blue);
}

.division-heritage {
  --division-accent: var(--ars-gold-light);
}

.division-header {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(240px, .75fr);
  align-items: end;
  gap: 30px;
  margin-bottom: clamp(40px, 5vw, 68px);
}

.division-heading-main {
  min-width: 0;
}

.division-heading-main .section-label {
  margin-bottom: 20px;
}

.division-heading-main h2,
.division-heading-main .division-title {
  margin: 0;
  color: var(--ars-white);
  font-size: clamp(36px, 5.5vw, 76px);
  font-weight: 300;
  line-height: .98;
  letter-spacing: -.06em;
  overflow-wrap: anywhere;
}

.division-heading-main h2 em,
.division-heading-main .division-title em {
  color: var(--division-accent, var(--ars-gold-light));
  font-style: normal;
}

.division-heading-copy {
  position: relative;
  max-width: 470px;
  padding-left: 24px;
  border-left: 1px solid var(--ars-border-gold);
}

.division-heading-copy p {
  margin: 0;
  font-size: 13px;
  line-height: 1.95;
}

.division-number {
  display: inline-block;
  margin-bottom: 15px;
  color: var(--division-accent, var(--ars-gold));
  font-size: 11px;
  letter-spacing: .18em;
}

.product-showcase-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 27px;
}

.product-showcase-heading h3 {
  margin: 0;
  font-size: clamp(24px, 3.3vw, 38px);
  font-weight: 300;
}

.product-showcase-heading p {
  max-width: 450px;
  margin: 0;
  font-size: 12px;
  line-height: 1.8;
}

.product-showcase-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.product-card {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--ars-border);
  border-radius: 3px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .025),
      transparent 42%
    ),
    rgba(6, 9, 13, .8);
  transition:
    transform .4s var(--ars-ease),
    border-color .35s ease,
    box-shadow .35s ease;
}

.product-card:hover {
  transform: translateY(-5px);
  border-color: var(--ars-border-gold);
  box-shadow: 0 20px 55px rgba(0, 0, 0, .28);
}

.product-card.card-tone-blue:hover {
  border-color: var(--ars-border-blue);
}

.card-tone-blue {
  --card-accent: var(--ars-blue-light);
}

.card-tone-navy {
  --card-accent: #9aafc1;
}

.card-tone-gold {
  --card-accent: var(--ars-gold-light);
}

.product-image-frame {
  aspect-ratio: 4 / 3;
  border-bottom: 1px solid var(--ars-border);
}

.product-image-frame img,
.product-image-frame video {
  position: absolute;
  inset: 0;
}

.product-index {
  position: absolute;
  z-index: 3;
  top: 15px;
  left: 15px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  min-height: 28px;
  padding: 5px 8px;
  border: 1px solid rgba(193, 154, 73, .28);
  background: rgba(2, 3, 4, .75);
  color: var(--card-accent, var(--ars-gold-light));
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.product-card-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  padding: clamp(20px, 2.3vw, 29px);
}

.product-card-content .media-kicker {
  margin-bottom: 13px;
  color: var(--card-accent, var(--ars-gold-light));
}

.product-card-content h3 {
  margin-bottom: 13px;
  color: var(--ars-white);
  font-size: clamp(19px, 2.1vw, 26px);
  font-weight: 300;
  line-height: 1.2;
  letter-spacing: -.035em;
}

.product-card-content p {
  margin-bottom: 22px;
  font-size: 12px;
  line-height: 1.9;
}

.product-card-content a,
.product-card-content .card-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding-top: 5px;
  color: var(--card-accent, var(--ars-gold-light));
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: gap .3s var(--ars-ease);
}

.product-card-content a:hover,
.product-card-content .card-link:hover {
  gap: 16px;
}

.division-media-block,
.division-gallery-block {
  margin-top: clamp(65px, 8vw, 100px);
}

.division-media-block > .subsection-heading,
.division-gallery-block > .subsection-heading {
  margin-bottom: 30px;
  font-size: clamp(27px, 3.7vw, 43px);
}

.division-video-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.video-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--ars-border);
  background: rgba(255, 255, 255, .015);
  transition:
    border-color .3s ease,
    transform .35s var(--ars-ease);
}

.video-card:hover {
  border-color: var(--ars-border-gold);
  transform: translateY(-3px);
}

.video-card video,
.video-card iframe {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
  background: #020304;
  object-fit: cover;
}

.video-card img {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.video-card > div,
.video-card figcaption,
.video-card .video-card-content {
  padding: 20px 22px;
}

.video-card h3 {
  margin-bottom: 8px;
  font-size: 19px;
  font-weight: 300;
}

.video-card p {
  margin-bottom: 0;
  font-size: 12px;
  line-height: 1.8;
}

.image-showcase-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}

.gallery-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  border: 1px solid var(--ars-border);
  background: #05080c;
}

.gallery-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(.85) contrast(1.04);
  transition:
    transform .8s var(--ars-ease-premium),
    filter .5s ease;
}

.gallery-card:hover img {
  filter: saturate(1) contrast(1.05);
}


/* 09 — CONTACT SECTION
========================================================= */

.media-contact {
  position: relative;
  overflow: hidden;
  padding: clamp(90px, 11vw, 155px) 0;
  background:
    radial-gradient(
      ellipse at 80% 30%,
      rgba(21, 155, 255, .075),
      transparent 38%
    ),
    radial-gradient(
      ellipse at 12% 85%,
      rgba(193, 154, 73, .045),
      transparent 36%
    ),
    #05080c;
}

.media-contact::before {
  position: absolute;
  top: 0;
  right: var(--ars-gutter);
  left: var(--ars-gutter);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(193, 154, 73, .32),
    rgba(21, 155, 255, .25),
    transparent
  );
  content: "";
}

.media-contact .section-header {
  max-width: 760px;
}

.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  align-items: start;
  gap: 24px;
}

.contact-card {
  position: relative;
  min-width: 0;
  padding: clamp(25px, 3.5vw, 44px);
  border: 1px solid var(--ars-border);
  border-radius: 3px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .03),
      transparent 48%
    ),
    rgba(3, 5, 8, .66);
}

.contact-card h3 {
  margin-bottom: 18px;
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 300;
}

.contact-card > p {
  margin-bottom: 28px;
  font-size: 13px;
  line-height: 1.95;
}

.contact-number {
  display: inline-block;
  margin-bottom: 20px;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--ars-gold-light);
  font-size: 12px;
  transition: color .25s ease;
  overflow-wrap: anywhere;
}

.contact-link:hover {
  color: var(--ars-blue-light);
}

.ars-contact-form-wrap {
  min-width: 0;
  padding: clamp(25px, 3.5vw, 44px);
  border: 1px solid var(--ars-border);
  border-radius: 3px;
  background:
    linear-gradient(
      135deg,
      rgba(21, 155, 255, .025),
      transparent 45%
    ),
    rgba(7, 11, 16, .72);
}

.ars-contact-form-wrap h3 {
  margin-bottom: 27px;
  font-size: clamp(24px, 3vw, 34px);
  font-weight: 300;
}

.ars-contact-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.contact-form-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8px;
}

.contact-form-field:has(textarea),
.contact-form-field.full-width {
  grid-column: 1 / -1;
}

.contact-form-field label {
  color: var(--ars-text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.contact-form-field input,
.contact-form-field textarea,
.contact-form-field select {
  width: 100%;
  min-height: 48px;
  padding: 13px 15px;
  border: 1px solid rgba(255, 255, 255, .1);
  border-radius: 2px;
  background: rgba(2, 3, 4, .52);
  color: var(--ars-white);
  font-size: 12px;
  transition:
    border-color .25s ease,
    background .25s ease,
    box-shadow .25s ease;
}

.contact-form-field textarea {
  min-height: 130px;
  resize: vertical;
}

.contact-form-field input::placeholder,
.contact-form-field textarea::placeholder {
  color: #606b76;
}

.contact-form-field input:focus,
.contact-form-field textarea:focus,
.contact-form-field select:focus {
  border-color: rgba(21, 155, 255, .65);
  outline: 0;
  background: rgba(8, 15, 23, .85);
  box-shadow: 0 0 0 3px rgba(21, 155, 255, .07);
}

.ars-contact-form button,
.ars-contact-form input[type="submit"] {
  grid-column: 1 / -1;
  justify-self: start;
  min-width: 170px;
}

.ars-social-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 30px;
}

.ars-social-links a {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  justify-content: center;
  padding: 9px 13px;
  border: 1px solid var(--ars-border);
  color: var(--ars-text-muted);
  font-size: 10px;
  letter-spacing: .04em;
  transition:
    color .25s ease,
    border-color .25s ease,
    background .25s ease;
}

.ars-social-links a:hover {
  border-color: var(--ars-border-gold);
  background: rgba(193, 154, 73, .045);
  color: var(--ars-gold-light);
}

.contact-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}


/* 10 — FOOTER
========================================================= */

.ars-footer {
  position: relative;
  overflow: hidden;
  padding: 65px var(--ars-gutter) 25px;
  border-top: 1px solid rgba(255, 255, 255, .065);
  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(21, 155, 255, .045),
      transparent 55%
    ),
    #020304;
}

.ars-footer::before {
  position: absolute;
  top: 0;
  left: 50%;
  width: min(450px, 70%);
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--ars-gold),
    transparent
  );
  transform: translateX(-50%);
  opacity: .55;
  content: "";
}

.footer-top,
.footer-bottom {
  width: min(var(--ars-container), 100%);
  margin-inline: auto;
}

.footer-top {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
  gap: 45px;
  padding-bottom: 45px;
}

.footer-brand {
  max-width: 470px;
}

.footer-logo-link {
  display: inline-flex;
  align-items: center;
  margin-bottom: 20px;
}

.footer-logo {
  display: block;
  width: auto;
  max-width: 175px;
  max-height: 65px;
  object-fit: contain;
}

.footer-tagline {
  max-width: 370px;
  margin-bottom: 0;
  color: var(--ars-text-muted);
  font-size: 12px;
  line-height: 1.95;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  align-content: start;
  justify-content: flex-end;
  gap: 13px 25px;
}

.footer-links a {
  color: var(--ars-text-muted);
  font-size: 11px;
  transition: color .25s ease;
}

.footer-links a:hover {
  color: var(--ars-gold-light);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-top: 23px;
  border-top: 1px solid rgba(255, 255, 255, .065);
}

.footer-bottom p,
.footer-bottom small {
  margin: 0;
  color: var(--ars-text-dim);
  font-size: 10px;
  letter-spacing: .025em;
}

.footer-back-to-top {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--ars-gold-light);
  font-family: var(--ars-mono);
  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition:
    color .25s ease,
    gap .25s ease;
}

.footer-back-to-top:hover {
  gap: 15px;
  color: var(--ars-blue-light);
}


/* 11 — REVEAL ANIMATIONS
========================================================= */

@media (prefers-reduced-motion: no-preference) {
  .media-spotlight [data-reveal],
  .media-division [data-reveal],
  .media-contact [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity .75s var(--ars-ease-premium),
      transform .75s var(--ars-ease-premium);
  }

  .media-spotlight [data-reveal].is-visible,
  .media-division [data-reveal].is-visible,
  .media-contact [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ars-glow-breathe {
  from {
    transform: scale(.97);
    opacity: .65;
  }

  to {
    transform: scale(1.03);
    opacity: 1;
  }
}


/* 12 — LARGE DESKTOP
========================================================= */

@media (min-width: 1600px) {
  .media-hero-content {
    width: min(1100px, 100%);
  }

  .media-hero-title {
    font-size: clamp(100px, 8.4vw, 160px);
  }

  .media-spotlight,
  .media-division,
  .media-contact {
    padding-top: 165px;
    padding-bottom: 165px;
  }
}


/* 13 — TABLET
========================================================= */

@media (max-width: 1050px) {
  :root {
    --ars-gutter: clamp(24px, 4vw, 48px);
  }

  .ars-nav-shell {
    gap: 18px;
    padding-inline: 16px;
  }

  .ars-primary-nav {
    gap: 15px;
  }

  .ars-primary-nav a {
    font-size: 10px;
  }

  .ars-nav-brand img,
  .ars-nav-brand svg {
    max-width: 125px;
  }

  .media-hero {
    min-height: 800px;
  }

  .spotlight-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .spotlight-display-card {
    min-height: 430px;
  }

  .advertising-rotator {
    min-height: 300px;
  }

  .division-header {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .division-heading-copy {
    max-width: 700px;
  }

  .product-showcase-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contact-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .contact-card {
    min-height: auto;
  }
}


/* 14 — MOBILE NAVIGATION
========================================================= */

@media (max-width: 760px) {
  html {
    scroll-padding-top: 80px;
  }

  .ars-site-header {
    padding: 12px 16px 0;
  }

  .ars-nav-shell {
    min-height: 62px;
    padding: 9px 13px;
  }

  .ars-nav-brand img,
  .ars-nav-brand svg {
    max-width: 120px;
    max-height: 38px;
  }

  .ars-menu-toggle {
    display: flex;
    flex-direction: column;
  }

  .ars-primary-nav {
    position: absolute;
    top: calc(100% + 9px);
    right: 0;
    left: 0;
    display: flex;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding: 8px 17px;
    border: 1px solid var(--ars-border);
    background: rgba(3, 5, 8, .97);
    box-shadow: 0 20px 50px rgba(0, 0, 0, .42);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-7px);
    transition:
      opacity .25s ease,
      visibility .25s ease,
      transform .25s ease;
  }

  .ars-primary-nav.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ars-primary-nav a {
    padding: 13px 2px;
    border-bottom: 1px solid rgba(255, 255, 255, .055);
    font-size: 11px;
    white-space: normal;
  }

  .ars-primary-nav a:last-child {
    border-bottom: 0;
  }

  .ars-primary-nav a::after {
    display: none;
  }

  .media-hero {
    min-height: 760px;
    min-height: max(760px, 100svh);
    align-items: center;
    padding: 135px 25px 110px;
  }

  .media-hero::after {
    background:
      linear-gradient(
        90deg,
        rgba(2, 3, 4, .78),
        rgba(2, 3, 4, .5)
      ),
      linear-gradient(
        0deg,
        #020304 0%,
        transparent 32%,
        rgba(2, 3, 4, .38) 100%
      );
  }

  .media-background-glow {
    top: 18%;
    right: -45%;
    width: 130vw;
  }

  .hero-energy-lines::before {
    left: 12px;
  }

  .hero-energy-lines::after {
    right: 12px;
  }

  .media-hero-content {
    padding-block: 12px;
  }

  .media-logo-wrapper {
    margin-bottom: 35px;
  }

  .media-logo {
    max-width: 165px;
    max-height: 66px;
  }

  .media-overline {
    gap: 10px;
    margin-bottom: 21px;
    font-size: 9px;
    letter-spacing: .15em;
  }

  .media-overline::before {
    width: 24px;
  }

  .media-hero-title {
    margin-bottom: 22px;
    font-size: clamp(51px, 12vw, 88px);
    line-height: .94;
    letter-spacing: -.06em;
  }

  .media-hero-subtitle {
    margin-bottom: 17px;
    font-size: clamp(17px, 4.7vw, 24px);
  }

  .hero-description {
    margin-bottom: 27px;
    font-size: 13px;
    line-height: 1.85;
  }

  .media-buttons {
    align-items: stretch;
    gap: 10px;
  }

  .btn-primary,
  .btn-secondary {
    min-height: 48px;
    padding: 12px 16px;
    font-size: 10px;
  }

  .hero-scroll-indicator {
    right: 25px;
    bottom: 25px;
    font-size: 8px;
  }

  .hero-scroll-indicator::before {
    width: 26px;
  }

  .media-spotlight,
  .media-division,
  .media-contact {
    padding-top: 85px;
    padding-bottom: 85px;
  }

  .section-header {
    margin-bottom: 35px;
  }

  .spotlight-heading,
  .subsection-heading {
    font-size: clamp(33px, 8vw, 48px);
  }

  .spotlight-video-card,
  .spotlight-display-card {
    padding: 19px;
  }

  .spotlight-card-heading {
    flex-direction: column;
    gap: 12px;
  }

  .spotlight-video-footer,
  .advertising-display-footer {
    flex-wrap: wrap;
  }

  .advertising-rotator {
    min-height: 250px;
  }

  .advertising-slides {
    min-height: 250px;
  }

  .film-library-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .film-card-content {
    padding: 15px;
  }

  .film-card-content h3 {
    font-size: 16px;
  }

  .film-card-content p {
    font-size: 11px;
  }

  .division-heading-main h2,
  .division-heading-main .division-title {
    font-size: clamp(38px, 9vw, 60px);
  }

  .division-heading-copy {
    padding-left: 17px;
  }

  .product-showcase-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .product-showcase-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-card-content {
    padding: 16px;
  }

  .product-card-content h3 {
    font-size: 19px;
  }

  .product-card-content p {
    font-size: 11px;
  }

  .product-card-content a,
  .product-card-content .card-link {
    font-size: 9px;
  }

  .division-video-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .image-showcase-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .contact-card,
  .ars-contact-form-wrap {
    padding: 23px;
  }

  .ars-contact-form {
    grid-template-columns: minmax(0, 1fr);
    gap: 17px;
  }

  .contact-form-field:has(textarea),
  .contact-form-field.full-width {
    grid-column: auto;
  }

  .ars-contact-form button,
  .ars-contact-form input[type="submit"] {
    grid-column: auto;
  }

  .ars-footer {
    padding-top: 50px;
  }

  .footer-top {
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
  }

  .footer-links {
    justify-content: flex-start;
    gap: 13px 20px;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }
}


/* 15 — SMALL MOBILE
========================================================= */

@media (max-width: 480px) {
  :root {
    --ars-gutter: 20px;
  }

  body {
    font-size: 14px;
  }

  .media-hero {
    min-height: 740px;
    min-height: max(740px, 100svh);
    padding-inline: 21px;
  }

  .media-hero-title {
    font-size: clamp(45px, 12.5vw, 61px);
  }

  .media-hero-subtitle {
    font-size: 17px;
  }

  .media-buttons {
    flex-direction: column;
    align-items: stretch;
  }

  .media-buttons .btn-primary,
  .media-buttons .btn-secondary {
    width: 100%;
  }

  .film-library-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .film-card img,
  .film-card video {
    aspect-ratio: 16 / 8.5;
  }

  .product-showcase-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .product-image-frame {
    aspect-ratio: 16 / 10;
  }

  .product-card-content h3 {
    font-size: 22px;
  }

  .image-showcase-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .gallery-card {
    aspect-ratio: 16 / 10;
  }

  .contact-card,
  .ars-contact-form-wrap {
    padding: 20px;
  }

  .ars-social-links {
    gap: 8px;
  }

  .ars-social-links a {
    padding-inline: 10px;
    font-size: 9px;
  }

  .footer-links {
    gap: 12px 17px;
  }
}


/* 16 — REDUCED MOTION / ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }

  [data-hero-reveal],
  [data-reveal],
  .media-spotlight [data-reveal],
  .media-division [data-reveal],
  .media-contact [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
  }
}


/* 17 — PRINT
========================================================= */

@media print {
  .ars-site-header,
  .hero-scroll-indicator,
  .media-buttons,
  .advertising-control,
  .advertising-pause,
  .ars-contact-form-wrap,
  .footer-back-to-top {
    display: none !important;
  }

  body,
  .media-hero,
  .media-spotlight,
  .media-division,
  .media-contact,
  .ars-footer {
    color: #111;
    background: #fff;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    color: #111;
  }
   }










